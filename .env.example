# Frontend integration configuration (MVP).
# Copy this file to .env.local and adjust as needed. This example file is
# committed; real .env* files are git-ignored.

# Mock mode is ON by default. Set to exactly "false" to use the real backend.
NEXT_PUBLIC_USE_MOCK=true

# API base URL used when mock mode is off. Trailing slashes are ignored.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Mock scenario used when mock mode is on. This variable is a frontend-only
# addition and is NOT part of the team's decisions document.
# Valid values:
#   mixed (default)
#   all-supported
#   all-insufficient
#   sample-null-urls
#   INVALID_REQUEST
#   INVALID_REPOSITORY_URL
#   REPOSITORY_ACCESS_DENIED
#   EVIDENCE_RETRIEVAL_FAILED
#   EVALUATION_FAILED
#   timeout
NEXT_PUBLIC_MOCK_SCENARIO=mixed
